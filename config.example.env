HOST=127.0.0.1
PORT=5000
MAX_CONCURRENT_JOBS=2
MAX_TARGETS=16
MAX_PORTS=4096
SOCKET_TIMEOUT=0.5
BANNER_TIMEOUT=0.75
LOG_LEVEL=INFO
SCAN_DB=data/scans.db
REPORTS_DIR=reports

# Authentication is disabled by default for local development.
# For controlled production deployments, set AUTH_ENABLED=true and provide:
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=<Werkzeug password hash>
# AUTH_ROLE=operator
# SECRET_KEY=<long-random-secret>
# SECURE_COOKIES=true   # enable when served over HTTPS
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_ROLE=operator
SECRET_KEY=
SECURE_COOKIES=false
